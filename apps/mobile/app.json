{
  "expo": {
    "name": "Zhaan",
    "slug": "zhaan-booking",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zhaan.booking"
    },
    "android": {
      "package": "com.zhaan.booking"
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
